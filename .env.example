APP_ENV=development
# Leave blank locally to use backend/data/auth.sqlite3. Set to PostgreSQL in production.
DATABASE_URL=
# Set to at least 32 random characters for production. Keep stable between restarts.
AUTH_SECRET_KEY=
# Set to false after account creation if public signups should be disabled.
ALLOW_SIGNUP=true
COOKIE_SECURE=false
# Persistent writable path; mount this directory in deployments.
FORMPILOT_DATA_DIR=backend/data
CORS_ORIGINS=http://127.0.0.1:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_FILE_MB=20
MAX_PDF_PAGES=30
SESSION_TTL_HOURS=12
